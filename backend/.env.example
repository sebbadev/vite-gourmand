# ==============================================================================
# CONFIGURATION ENVIRONNEMENT BACKEND — VITE & GOURMAND (FastAPI)
# Copier ce fichier vers 'backend/.env' et renseigner vos valeurs locales
# ==============================================================================

# --- Métadonnées Application ---
PROJECT_NAME="Vite & Gourmand API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# --- Sécurité & Authentification JWT ---
# Générer une clé aléatoire robuste en production (ex: openssl rand -hex 32)
SECRET_KEY="remplacer-par-une-cle-secrete-aleatoire-tres-longue"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Base de données Relationnelle (PostgreSQL) ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="votre_mot_de_passe_postgres"
POSTGRES_DB="vite_gourmand"

# --- Base de données Orientée Documents (MongoDB) ---
MONGO_URI="mongodb://localhost:27017"
MONGO_DB="vite_gourmand_nosql"

# --- Origines CORS Autorisées (Format liste JSON) ---
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]